cat > .env.example << 'EOF'
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///coinpilot.db

# Real Binance API
BINANCE_API_KEY=your_key_here
BINANCE_API_SECRET=your_secret_here
BINANCE_URL=https://api.binance.com

# Alchemy Sepolia RPC
SEPOLIA_RPC_URL=

# Resend
RESEND_API_KEY=
NOTIFY_EMAIL=
EMAIL_FROM=CoinPilot <onboarding@resend.dev>

# Admin default balance (88,988,998,098 USDT + 1,000,000 test coins)
ADMIN_BALANCE_USDT=88988998098
ADMIN_BALANCE_TEST=1000000
EOF
